  textoResultado: {fileID: 1690856115}
  text: {fileID: 566983374}
  panel: {fileID: 116460890}
  flag: 0
  continueButton: {fileID: 633848930}
  texto: {fileID: 1690856115}
  dialogos:
  - "La investigaci\xF3n determin\xF3 que el homicidio ocurri\xF3 durante una confrontaci\xF3n
    entre dos hermanas."
  - "La principal sospechosa era la hermana que hab\xEDa heredado la vivienda familiar."
  - "El cuchillo permiti\xF3 identificar el m\xE9todo utilizado."
  - "La fotograf\xEDa confirm\xF3 el v\xEDnculo familiar entre ambas mujeres."
  - "La nota de desalojo permiti\xF3 establecer un posible motivo relacionado con
    la p\xE9rdida de la vivienda."
  - "Las tres evidencias permitieron reconstruir el contexto del crimen y establecer
    una hip\xF3tesis sobre los acontecimientos."
  - Gracias por su apoyo. Caso cerrado
  velocidad: 0.05
  nombreEscena: MainMenu
